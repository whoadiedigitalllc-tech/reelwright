{
  "name": "reelwright",
  "productName": "Reelwright",
  "version": "0.1.0",
  "private": true,
  "description": "Reelwright: a plain, offline desktop video editor. Every feature free.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests",
    "e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "app.reelwright.desktop",
    "productName": "Reelwright",
    "files": [
      "out/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "immer": "^10.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "axe-core": "^4.14.1",
    "electron": "^45.4.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "ffmpeg-static@5.2.0": true,
    "electron@45.4.1": true
  }
}
